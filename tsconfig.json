{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vite/client"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "flows/**/*.ts",
    "infra/**/*.ts",
    "spikes/**/*.ts",
    "gallery/**/*.ts",
    "gallery/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "test/**/*.ts",
    "vite.config.ts",
    "scripts/**/*.ts",
    "scripts/lib/launchpad-attribution.mjs",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}

{
  "name": "launchpad",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub template: repo hygiene, docs, agent instructions, and quality gates for new projects.",
  "license": "MIT",
  "launchpadTemplate": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "npm run conflict-markers && npm run workflow-yaml && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run secrets && npm run secret-usage && npm run preview-workflow && npm run placeholders && npm run attribution && npm run nodrift",
    "build": "vite build",
    "dev:gallery": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "secretlint \"**/*\"",
    "conflict-markers": "node scripts/check-conflict-markers.mjs",
    "workflow-yaml": "node scripts/check-workflow-yaml.mjs",
    "secret-usage": "node scripts/check-secret-usage.mjs",
    "preview-workflow": "node scripts/check-preview-workflow.mjs",
    "placeholders": "node scripts/check-placeholders.mjs",
    "attribution": "node scripts/check-attribution.mjs",
    "nodrift": "node scripts/run-nodrift-check.mjs",
    "init-project": "node scripts/init-project.mjs",
    "repo-settings": "node scripts/repo-settings.mjs",
    "verify-action-pins": "node scripts/verify-action-pins.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "node scripts/check-conflict-markers.mjs",
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "//overrides.undici": "Wrangler miniflare still resolves undici 7.29.x; pin 7.30.1 for npm audit fixes until upstream bumps.",
  "overrides": {
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@didi-build/nodrift": "0.1.0",
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.37.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "secretlint": "10.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  }
}

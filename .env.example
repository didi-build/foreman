# Copy to `.env` for local development. Names only — never put real values in git.
# Document each variable in README or docs/architecture/ when you add one.

# EXAMPLE_API_URL=

# Cloudflare Workers preview deploy (repository secrets in CI; optional locally for wrangler preview)
# CLOUDFLARE_API_TOKEN_PREVIEW=   # Workers Scripts Edit only; never D1 or R2 Edit (PR-branch code can reach this token)
# CLOUDFLARE_ACCOUNT_ID=

# init-project / Bootstrap (non-interactive): true | false
# LAUNCHPAD_COLLECTS_PERSONAL_DATA=

# DigitalOcean platform module (ADR 0106, D-193). The only place in infra/ where DigitalOcean is
# declared (D-146, `npm run infra-boundaries`). No provider block: the provider reads its token from
# DIGITALOCEAN_TOKEN at run time, never from a file.
terraform {
  required_providers {
    # Exact pin. The lock file is generated by CI the first time (ADR 0110), because the registry
    # could not be reached when this module was written.
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "2.106.0"
    }
  }
}

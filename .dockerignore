# Keep images small and free of secrets: only files a Dockerfile copies explicitly matter.
.git
node_modules
.env
.env.*
**/*.test.ts
# The weekly test set's case trees hold their fixtures' own tests, which the eval image needs byte
# for byte: the case loader checks each tree against its source (src/agent-images/eval/, ADR 0117).
!eval/cases/*/tree/**/*.test.ts
coverage
test-results
dist
infra
docs
**/container-check.env

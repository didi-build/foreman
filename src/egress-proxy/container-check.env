# Settings for scripts/check-service-container.sh only. Not a real run or credential: the check
# only starts the proxy and calls /health, so nothing is resolved or forwarded.
RUN_ID=container-check
ALLOWED_HOSTS=github.com
MODEL_PROVIDERS=[{"name":"anthropic","upstream":"https://api.anthropic.com","credential":"x-api-key","secretPath":"projects/container-check/models/anthropic"}]
MAX_MODEL_REQUESTS=200
MAX_REJECTED_MODEL_REQUESTS=5
SECRET_PROJECTS_CONTAINER_CHECK_MODELS_ANTHROPIC=container-check-not-a-secret

# Settings for scripts/check-service-container.sh only. Not a real database: nothing listens on
# port 1, and the API connects on first use, so the container starts and answers /health.
DATABASE_URL=postgresql://container-check@127.0.0.1:1/none
# The Windmill start's plain settings (O-101). No token: every start is refused.
WINDMILL_HOST=windmill.example.com
WINDMILL_WORKSPACE=container-check
HTTPS_PROXY=http://127.0.0.1:1

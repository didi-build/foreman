# Settings for scripts/check-service-container.sh only. Not a real cluster or credential: nothing
# listens on port 1 and the container has no ServiceAccount token, so every list fails and is
# logged, while the watcher still starts and answers /health. No Windmill token: no start is made.
KUBERNETES_API=https://127.0.0.1:1
AGENT_NAMESPACES=agents-container-check
WINDMILL_HOST=windmill.example.com
WINDMILL_WORKSPACE=container-check
HTTPS_PROXY=http://127.0.0.1:1

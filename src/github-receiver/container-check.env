# Settings for scripts/check-service-container.sh only. Not a real database or secret: nothing
# listens on port 1, and the receiver connects on first use, so the container starts and
# answers /health.
DATABASE_URL=postgresql://container-check@127.0.0.1:1/none
SECRET_PLATFORM_GITHUB_RUNNER_WEBHOOK_SECRET=container-check-not-a-secret
GITHUB_DEVELOPER_APP_LOGIN=container-check-developer[bot]
GITHUB_DESIGNER_APP_LOGIN=container-check-designer[bot]
GITHUB_RUNNER_APP_SLUG=container-check-runner
